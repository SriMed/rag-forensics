{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SriMed/rag-forensics/backend/evals/prompt_audit/v1/human-review.schema.json",
  "title": "Prompt evaluation human review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "run_id", "reviewer", "reviewed_at", "reviews"],
  "properties": {
    "schema_version": {"const": "prompt-human-review.v1"},
    "dataset_version": {"const": "1.0.0"},
    "run_id": {"type": ["string", "null"], "description": "Identifier or path of the model run being reviewed."},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "role": {"type": ["string", "null"]}
      }
    },
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "judgment", "rationale"],
        "properties": {
          "case_id": {"type": "string"},
          "judgment": {"enum": ["pass", "fail", "uncertain"]},
          "rationale": {"type": "string", "minLength": 1},
          "criterion_notes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["criterion", "judgment", "note"],
              "properties": {
                "criterion": {"type": "string"},
                "judgment": {"enum": ["pass", "fail", "uncertain"]},
                "note": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "notes": {"type": ["string", "null"]}
  }
}
